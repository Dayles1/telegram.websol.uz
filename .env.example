APP_NAME="Websol Telegram"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://telegram.websol.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegram_websol
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=telegramWebsol
# Must stay above the longest job timeout (send job: 360s) or a running job is started twice.
DB_QUEUE_RETRY_AFTER=400

CACHE_STORE=database

MAIL_MAILER=log

# --- Telegram (MadelineProto user accounts) -------------------------------
# App credentials from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# How sessions present themselves to Telegram. Never change it once accounts are connected.
TELEGRAM_DEVICE_MODEL=Server
# Queues (names carry the project name, see deploy/supervisor.conf): everything else / sends.
TELEGRAM_QUEUE=telegramWebsol
TELEGRAM_SEND_QUEUE=telegramWebsol-sending

# --- Alerts to a Telegram chat ---------------------------------------------
# 1. Create a bot with @BotFather, put its token here.
# 2. Write any message to the bot (or add it to a group).
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- External statistics dashboard -----------------------------------------
# /api/stats/* answer only with header "X-Stats-Token: <this>" (or a superadmin API token).
STATS_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
